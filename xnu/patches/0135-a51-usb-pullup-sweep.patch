A51 USB: sweep the D+ pull-up configurations from the A51 kernel's gadget path.

Boot 36 (0134, PHY brought up exactly as phy_exynos_usb_v3p1_enable) still
logged LINESTATE SE0 for a minute. The A51 kernel does more before the
gadget's RUN_STOP: dwc3_otg_start_gadget issues SET_DPDM_PULLDOWN, which is
phy_exynos_usb_v3p1_config_host_mode (DP/DM pull-downs on, FORCE_BVALID,
FORCE_VBUSVALID and VBUSVLDEXTSEL off), then dwc3_gadget_pullup issues
SET_DPPULLUP_ENABLE (VBUSVLDEXT on); utmi_init also runs pipe_ovrd (PIPE3
forced idle, PMA low power), the DT sets common_block_disable, and
dwc3_phy_setup sets GUSB3PIPECTL.SUSPHY. Replace the plain line-state log
with a sweep that adds these one at a time every 10 s and stops at the first
step showing J/K, a link-state change or an event.

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 4dca5cd..adb9e0f 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -850,6 +850,10 @@ ud_event(uint32_t ev)
 	}
 }
 
+#if defined(A51)
+static void usbcon_wr(vm_offset_t base, uint32_t off, uint32_t v);
+#endif
+
 static void
 ud_thread(void *arg __unused, wait_result_t wr __unused)
 {
@@ -873,21 +877,48 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 		}
 #if defined(A51)
 		/*
-		 * Line state while running (first ~60 s, every 2 s): HSP_TEST
-		 * LINESTATE [21:20] is what the PHY sees on D+/D- (0 SE0, 1 J =
-		 * D+ high, 2 K). J with no host activity points at the USB-C
-		 * switch (SM5713 MUIC), SE0 at the PHY's pull-up (boots 28-30).
+		 * Line-state sweep, first ~50 s: boots 35/36 saw SE0 (no D+ pull-up)
+		 * with the PHY forced VBUS-valid. Every 10 s step to the next
+		 * configuration from the A51 kernel's gadget start-up path, and stop
+		 * at the first that shows J/K or any link activity:
+		 *  1: as brought up (VBUS forced, phy_exynos_usb_v3p1_enable)
+		 *  2: Android's final state: SET_DPDM_PULLDOWN (config_host_mode:
+		 *     DP/DM pull-downs on, FORCE_BVALID/VBUSVALID and VBUSVLDEXTSEL
+		 *     off) then SET_DPPULLUP_ENABLE (VBUSVLDEXT on)
+		 *  3: + phy_exynos_usb_v3p1_pipe_ovrd (PIPE3 forced idle, PMA off)
+		 *     and HSP COMMONONN|EN_UTMISUSPEND (DT common_block_disable 1)
+		 *  4: + GUSB3PIPECTL.SUSPHY (dwc3_phy_setup, revision > 1.94a)
 		 */
 		if (ticks <= 60000 && (ticks % 2000) == 0) {
 			static vm_offset_t u;
+			static int step = 1, settled;
 			if (u == 0) {
 				u = ml_io_map(USBCON_PA, USBCON_SIZE);
 			}
 			if (u != 0) {
-				uint32_t t = usb_rd(u, USBCON_HSP_TEST);
-				printf("SWEET USB: A51 t=%us LINESTATE %u HSP_TEST 0x%08x UTMI 0x%08x HSP 0x%08x DSTS 0x%08x DCTL 0x%08x\n",
-				    ticks / 1000, (t >> 20) & 3u, t, usb_rd(u, USBCON_UTMI), usb_rd(u, USBCON_HSP),
-				    dwc_rd(DSTS), dwc_rd(DCTL));
+				uint32_t t = usb_rd(u, USBCON_HSP_TEST), st = dwc_rd(DSTS);
+				printf("SWEET USB: A51 t=%us step %d LINESTATE %u HSP_TEST 0x%08x UTMI 0x%08x HSP 0x%08x LINK_CTRL 0x%08x DSTS 0x%08x events %u\n",
+				    ticks / 1000, step, (t >> 20) & 3u, t, usb_rd(u, USBCON_UTMI), usb_rd(u, USBCON_HSP),
+				    usb_rd(u, USBCON_LINK_CTRL), st, ud.events);
+				if (!settled && (((t >> 20) & 3u) != 0 || ((st >> 18) & 0xfu) != 4 || ud.events)) {
+					settled = 1;
+					printf("SWEET USB: A51 line came alive at step %d\n", step);
+				}
+				if (!settled && (ticks % 10000) == 0 && step < 4) {
+					step++;
+					if (step == 2) {
+						usbcon_wr(u, USBCON_UTMI, (usb_rd(u, USBCON_UTMI) | UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN) &
+						    ~(UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID));
+						usbcon_wr(u, USBCON_HSP, (usb_rd(u, USBCON_HSP) & ~HSP_VBUSVLDEXTSEL) | HSP_VBUSVLDEXT);
+					} else if (step == 3) {
+						usbcon_wr(u, USBCON_LINK_CTRL, (usb_rd(u, USBCON_LINK_CTRL) | (1u << 16) | (1u << 18)) & ~(1u << 17));
+						usbcon_wr(u, 0x48, usb_rd(u, 0x48) | (1u << 4));      /* COMBO_PMA_CTRL.LOW_PWRN */
+						usbcon_wr(u, USBCON_HSP, usb_rd(u, USBCON_HSP) | HSP_COMMONONN | HSP_EN_UTMISUSPEND);
+					} else if (step == 4) {
+						dwc_wr(GUSB3PIPECTL, dwc_rd(GUSB3PIPECTL) | GUSB3PIPECTL_SUSPHY);
+					}
+					printf("SWEET USB: A51 -> step %d\n", step);
+				}
 			}
 		}
 #endif
