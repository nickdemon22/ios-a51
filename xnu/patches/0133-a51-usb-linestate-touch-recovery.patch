--- a/bsd/dev/a5xelte_touch.c
+++ b/bsd/dev/a5xelte_touch.c
@@ -1080,6 +1080,24 @@ a51ts_read_retry(uint8_t r0, uint8_t r1, uint8_t *buf, unsigned rlen)
 	return false;
 }
 
+static uint64_t a51ts_corner_t0;     /* mach time a corner hold began */
+
+static void
+a51ts_recovery_reset(void)
+{
+	vm_offset_t pmu = ml_io_map(0x11860000u, 0x1000);
+	printf("A51 TOUCH: corner held 3 s: warm reset into recovery\n");
+	delay(200000);                  /* let the console log reach the disk ring */
+	if (pmu == 0) {
+		return;
+	}
+	a5touch_write(pmu, 0x808, 0x12345678u);
+	a5touch_write(pmu, 0x80c, 0x12345674u);
+	a5touch_write(pmu, 0x908, 0x12345678u);
+	a5touch_write(pmu, 0x90c, 0x12345674u);
+	a5touch_write(pmu, 0x400, 1u);  /* EXYNOS_SWRESET */
+}
+
 static void
 a51ts_report(const uint8_t *p)
 {
@@ -1121,6 +1139,19 @@ a51ts_report(const uint8_t *p)
 		sweet_hid_key(0, 0);
 		return;
