 	}
 }
 
+#if defined(A51)
+static void
+usbcon_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * S-Boot leaves the DWC3 clocked but not the HS PHY: boot 27 timed out on the
+ * first SETEPCONFIG (no UTMI clock) with LINK_CTRL.FORCE_QACT clear and the
+ * PMU PHY control at 0x00010000. Power the PHY up as Samsung's Exynos 9610
+ * bootloader does (lk3rd maestro9610 phy_exynos_usb_v3p1_enable, HS path
+ * of USBCON v3.0, not_used_vbus_pad), after releasing the PMU isolation.
+ */
+static void
+a51_usb_phy_enable(void)
+{
+	vm_offset_t pmu = ml_io_map(trunc_page(PMU_USB_PHY_CTRL_PA), PAGE_SIZE);
+	vm_offset_t u = ml_io_map(USBCON_PA, USBCON_SIZE);
+	uint32_t r;
+
+	if (pmu == 0 || u == 0) {
+		printf("SWEET USB: A51 PHY map failed\n");
+		return;
+	}
+	volatile uint32_t *pmuctl = (volatile uint32_t *)(pmu + (PMU_USB_PHY_CTRL_PA & PAGE_MASK));
+	printf("SWEET USB: A51 PHY before: PMU 0x%08x LINK_CTRL 0x%08x CLKRST 0x%08x UTMI 0x%08x HSP 0x%08x HSP_TEST 0x%08x\n",
+	    *pmuctl, usb_rd(u, USBCON_LINK_CTRL), usb_rd(u, USBCON_CLKRST), usb_rd(u, USBCON_UTMI),
+	    usb_rd(u, USBCON_HSP), usb_rd(u, USBCON_HSP_TEST));
+	*pmuctl |= PMU_USB_PHY_ENABLE;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(10);
+
+	/* Force the q-channel active (keeps the link clock ungated). */
+	r = usb_rd(u, USBCON_LINK_CTRL) | LINKCTRL_DIS_QACT_ALL;
+	r &= ~LINKCTRL_FORCE_QACT;
+	delay(500);
+	usbcon_wr(u, USBCON_LINK_CTRL, r);
+	delay(500);
+	usbcon_wr(u, USBCON_LINK_CTRL, usb_rd(u, USBCON_LINK_CTRL) | LINKCTRL_FORCE_QACT);
+	delay(500);
+	/* Link reset */
+	r = usb_rd(u, USBCON_CLKRST);
+	usbcon_wr(u, USBCON_CLKRST, r | CLKRST_LINK_SW_RST);
+	delay(10);
+	usbcon_wr(u, USBCON_CLKRST, r & ~CLKRST_LINK_SW_RST);
+	/* PHY reset high, power on (SIDDQ off) */
+	usbcon_wr(u, USBCON_CLKRST, usb_rd(u, USBCON_CLKRST) | CLKRST_PHY_SW_RST | CLKRST_PHY_RST_SEL);
+	usbcon_wr(u, USBCON_HSP_TEST, usb_rd(u, USBCON_HSP_TEST) & ~HSP_TEST_SIDDQ);
+	usbcon_wr(u, USBCON_UTMI, usb_rd(u, USBCON_UTMI) &
+	    ~(UTMI_FORCE_SUSPEND | UTMI_FORCE_SLEEP | UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN));
+	/* PHY clock on, common block enabled (common_block_disable is not set) */
+	usbcon_wr(u, USBCON_HSP, (usb_rd(u, USBCON_HSP) | HSP_EN_UTMISUSPEND) & ~HSP_COMMONONN);
+	delay(100);
+	/* PHY reset low */
+	r = usb_rd(u, USBCON_CLKRST) | CLKRST_PHY_RST_SEL;
+	usbcon_wr(u, USBCON_CLKRST, r & ~(CLKRST_PHY_SW_RST | CLKRST_PORT_RST));
+	/* No VBUS pad: force VBUS-valid/B-valid and the D+ pull-up control. */
+	usbcon_wr(u, USBCON_LINK_CTRL, usb_rd(u, USBCON_LINK_CTRL) | LINKCTRL_BUS_FILTER_BYPASS_ALL);
+	usbcon_wr(u, USBCON_UTMI, usb_rd(u, USBCON_UTMI) | UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID);
+	usbcon_wr(u, USBCON_HSP, usb_rd(u, USBCON_HSP) | HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT);
+	delay(1000);
+	printf("SWEET USB: A51 PHY after:  PMU 0x%08x LINK_CTRL 0x%08x CLKRST 0x%08x UTMI 0x%08x HSP 0x%08x HSP_TEST 0x%08x\n",
+	    *pmuctl, usb_rd(u, USBCON_LINK_CTRL), usb_rd(u, USBCON_CLKRST), usb_rd(u, USBCON_UTMI),
+	    usb_rd(u, USBCON_HSP), usb_rd(u, USBCON_HSP_TEST));
+}
+#endif
