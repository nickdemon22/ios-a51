 static void
 sweet_usb_gadget_start(vm_offset_t dwc)
 {
@@ -866,6 +1004,31 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	ud.dma_pa = ptoa_64(pn);
 	ud_if_create();
 
+#if defined(A51)
+	/*
+	 * DWC3 side of Samsung's 9610 bring-up (lk3rd usbd3-ss.c): hold the USB2
+	 * PHY interface in reset while the PHY powers up, take the PHYs out of
+	 * suspend, drop U2_FREECLK_EXISTS (DT snps,dis-u2-freeclk-exists-quirk),
+	 * then reset the whole core once the PHY clock runs. Boot 28 powered the
+	 * PHY and ran the device controller without these and never connected.
+	 */
+	dwc_wr(GUSB2PHYCFG, dwc_rd(GUSB2PHYCFG) | GUSB2PHYCFG_PHYSOFTRST);
+	a51_usb_phy_enable();
+	dwc_wr(GUSB2PHYCFG, dwc_rd(GUSB2PHYCFG) & ~GUSB2PHYCFG_PHYSOFTRST);
+	delay(75);
+	dwc_wr(GUSB2PHYCFG, dwc_rd(GUSB2PHYCFG) &
+	    ~(GUSB2PHYCFG_SUSPHY | GUSB2PHYCFG_ENBLSLPM | GUSB2PHYCFG_U2_FREECLK_EXISTS));
+	dwc_wr(GUSB3PIPECTL, dwc_rd(GUSB3PIPECTL) & ~GUSB3PIPECTL_SUSPHY);
+	dwc_wr(GCTL, dwc_rd(GCTL) | GCTL_CORESOFTRESET | GCTL_U2RSTECN);
+	delay(1000);
+	dwc_wr(GCTL, dwc_rd(GCTL) & ~GCTL_CORESOFTRESET);
+	delay(1000);
+	/* Bus: cacheable/modifiable requests, INCR16 bursts (9610 bootloader). */
+	dwc_wr(0xc100 /* GSBUSCFG0 */, 0x22220000u | (1u << 3));
+	dwc_wr(GUSB2PHYCFG, (dwc_rd(GUSB2PHYCFG) & ~(0xfu << 10)) | (9u << 10));    /* USBTRDTIM 9 */
+	printf("SWEET USB: A51 core reset: GCTL 0x%08x GUSB2PHYCFG 0x%08x GUSB3PIPECTL 0x%08x GSTS 0x%08x DSTS 0x%08x\n",
+	    dwc_rd(GCTL), dwc_rd(GUSB2PHYCFG), dwc_rd(GUSB3PIPECTL), dwc_rd(0xc118), dwc_rd(DSTS));
+#endif
 	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
 	dwc_wr(DCTL, DCTL_CSFTRST);
 	int i;
@@ -902,7 +1065,11 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	dwc_wr(DALEPENA, 0x3);
 	ud_start_setup();
 
+#if defined(A51)
+	vm_offset_t qs = 0;
+#else
 	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+#endif
 	if (qs != 0) {
 		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
 		printf("SWEET USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
@@ -928,4 +1095,4 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 		thread_deallocate(thread);
 	}
 }
