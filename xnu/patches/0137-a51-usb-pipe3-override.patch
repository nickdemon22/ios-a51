+	/*
+	 * phy_exynos_usb_v3p1_pipe_ovrd: the USB3 PIPE PHY is not brought up,
+	 * so tell the link it is idle (PIPE3 force enable + RX electrical
+	 * idle, PHY status low) and keep its PMA in low power. Without this
+	 * the DWC3 never applied the D+ pull-up (boots 35-37, LINESTATE SE0);
+	 * with it the host enumerated the gadget within 2 s (boot 38). Also
+	 * HSP COMMONONN|EN_UTMISUSPEND, as the DT sets common_block_disable.
+	 */
+	usbcon_wr(u, USBCON_LINK_CTRL, (usb_rd(u, USBCON_LINK_CTRL) | (1u << 16) | (1u << 18)) & ~(1u << 17));
+	usbcon_wr(u, 0x48, usb_rd(u, 0x48) | (1u << 4));      /* COMBO_PMA_CTRL.LOW_PWRN */
+	usbcon_wr(u, USBCON_HSP, usb_rd(u, USBCON_HSP) | HSP_COMMONONN | HSP_EN_UTMISUSPEND);
