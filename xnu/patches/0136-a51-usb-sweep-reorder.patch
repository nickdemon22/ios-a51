A51 USB: reorder the pull-up sweep; stop only on line/link state.

Boot 37 ran Android's final PHY state as step 2: dropping the VBUS forces
made the link post a disconnect event (so the forced VBUS-valid does reach
the DWC3), which the sweep took as "alive" and stopped, with the line still
SE0. Keep VBUS forced while adding the pipe override/common block (2) and
GUSB3PIPECTL.SUSPHY (3), try Android's final state last (4), and stop only
on LINESTATE J/K or a link-state change.

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index adb9e0f..6f7b793 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -882,12 +882,15 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 		 * configuration from the A51 kernel's gadget start-up path, and stop
 		 * at the first that shows J/K or any link activity:
 		 *  1: as brought up (VBUS forced, phy_exynos_usb_v3p1_enable)
-		 *  2: Android's final state: SET_DPDM_PULLDOWN (config_host_mode:
+		 *  2: + phy_exynos_usb_v3p1_pipe_ovrd (PIPE3 forced idle, PMA off)
+		 *     and HSP COMMONONN|EN_UTMISUSPEND (DT common_block_disable 1)
+		 *  3: + GUSB3PIPECTL.SUSPHY (dwc3_phy_setup, revision > 1.94a)
+		 *  4: Android's final state: SET_DPDM_PULLDOWN (config_host_mode:
 		 *     DP/DM pull-downs on, FORCE_BVALID/VBUSVALID and VBUSVLDEXTSEL
 		 *     off) then SET_DPPULLUP_ENABLE (VBUSVLDEXT on)
-		 *  3: + phy_exynos_usb_v3p1_pipe_ovrd (PIPE3 forced idle, PMA off)
-		 *     and HSP COMMONONN|EN_UTMISUSPEND (DT common_block_disable 1)
-		 *  4: + GUSB3PIPECTL.SUSPHY (dwc3_phy_setup, revision > 1.94a)
+		 * Boot 37 ran step 4 second: the link reported a disconnect event
+		 * (VBUS-valid dropped) and the line stayed SE0, so events are not a
+		 * stop condition, only the line or link state is.
 		 */
 		if (ticks <= 60000 && (ticks % 2000) == 0) {
 			static vm_offset_t u;
@@ -900,22 +903,22 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 				printf("SWEET USB: A51 t=%us step %d LINESTATE %u HSP_TEST 0x%08x UTMI 0x%08x HSP 0x%08x LINK_CTRL 0x%08x DSTS 0x%08x events %u\n",
 				    ticks / 1000, step, (t >> 20) & 3u, t, usb_rd(u, USBCON_UTMI), usb_rd(u, USBCON_HSP),
 				    usb_rd(u, USBCON_LINK_CTRL), st, ud.events);
-				if (!settled && (((t >> 20) & 3u) != 0 || ((st >> 18) & 0xfu) != 4 || ud.events)) {
+				if (!settled && (((t >> 20) & 3u) != 0 || ((st >> 18) & 0xfu) != 4)) {
 					settled = 1;
 					printf("SWEET USB: A51 line came alive at step %d\n", step);
 				}
 				if (!settled && (ticks % 10000) == 0 && step < 4) {
 					step++;
 					if (step == 2) {
-						usbcon_wr(u, USBCON_UTMI, (usb_rd(u, USBCON_UTMI) | UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN) &
-						    ~(UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID));
-						usbcon_wr(u, USBCON_HSP, (usb_rd(u, USBCON_HSP) & ~HSP_VBUSVLDEXTSEL) | HSP_VBUSVLDEXT);
-					} else if (step == 3) {
 						usbcon_wr(u, USBCON_LINK_CTRL, (usb_rd(u, USBCON_LINK_CTRL) | (1u << 16) | (1u << 18)) & ~(1u << 17));
 						usbcon_wr(u, 0x48, usb_rd(u, 0x48) | (1u << 4));      /* COMBO_PMA_CTRL.LOW_PWRN */
 						usbcon_wr(u, USBCON_HSP, usb_rd(u, USBCON_HSP) | HSP_COMMONONN | HSP_EN_UTMISUSPEND);
-					} else if (step == 4) {
+					} else if (step == 3) {
 						dwc_wr(GUSB3PIPECTL, dwc_rd(GUSB3PIPECTL) | GUSB3PIPECTL_SUSPHY);
+					} else if (step == 4) {
+						usbcon_wr(u, USBCON_UTMI, (usb_rd(u, USBCON_UTMI) | UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN) &
+						    ~(UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID));
+						usbcon_wr(u, USBCON_HSP, (usb_rd(u, USBCON_HSP) & ~HSP_VBUSVLDEXTSEL) | HSP_VBUSVLDEXT);
 					}
 					printf("SWEET USB: A51 -> step %d\n", step);
 				}
